    given-names: Cristian
    affiliation: University of Udine, Udine, Italy
    email: cristian.curaba@uniud.it
license: AGPL-3.0-or-later
repository-code: https://github.com/cascade-platform-org/CASCADE
keywords:
  - cascading failures
  - interdependent networks
  - critical infrastructure
  - water distribution networks
  - network flows
