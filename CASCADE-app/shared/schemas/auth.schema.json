{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Entitlement": {
      "description": "Per-role quotas (ADR-0008). None means unbounded (e.g. admin).",
      "properties": {
        "max_nodes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Nodes"
        },
        "evals_per_minute": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evals Per Minute"
        }
      },
      "title": "Entitlement",
      "type": "object"
    },
    "AuthUser": {
      "description": "Decoded OIDC claims for the authenticated user, plus DB-owned authz.",
      "properties": {
        "sub": {
          "title": "Sub",
          "type": "string"
        },
        "email": {
          "title": "Email",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "db_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Db Id"
        },
        "entitlement": {
          "anyOf": [
            {
              "$ref": "#/$defs/Entitlement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "sub",
        "email",
        "display_name",
        "roles"
      ],
      "title": "AuthUser",
      "type": "object"
    }
  }
}