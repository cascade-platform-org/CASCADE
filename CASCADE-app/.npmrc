# madge@8 (dev-only, used by `npm run audit:circular`) declares a peer of
# typescript ^5.4.4, but this project is on TypeScript 6 (tsc + next build pass
# on it). npm ci's strict peer check would otherwise fail the install for a
# tool that never runs at build time. Ignore the peer mismatch instead of
# downgrading TypeScript. Remove once madge ships a TS 6 compatible peer range.
legacy-peer-deps=true
