{
  "version": "2.0.0",
  "tasks": [

    // -------------------------------------------------------------------------
    // Frontend — hot reload, no debugger (normal day-to-day dev)
    // -------------------------------------------------------------------------
    {
      "label": "CASCADE: Start Frontend",
      "type": "shell",
      "command": "[ -d node_modules ] || npm ci; npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/CASCADE-app"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": { "regexp": "^(.*)$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting\\.\\.\\.",
          "endsPattern": "Ready in"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "cascade-servers"
      }
    },

    // -------------------------------------------------------------------------
    // Frontend — debug mode: exposes Node inspector on port 9229
    // Run this task first, THEN attach "CASCADE: Frontend — Server (attach Node)"
    // from the Run & Debug panel to get breakpoints in Server Components.
    // -------------------------------------------------------------------------
    {
      "label": "CASCADE: Start Frontend (debug)",
      "type": "shell",
      "command": "[ -d node_modules ] || npm ci; npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/CASCADE-app",
        "env": {
          "NODE_OPTIONS": "--inspect=9229"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "next-debug",
        "pattern": { "regexp": "^(.*)$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting\\.\\.\\.",
          "endsPattern": "Ready in"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "cascade-servers"
      }
    },

    // -------------------------------------------------------------------------
    // Backend — start FastAPI with --reload (live reload, no breakpoints)
    // Use the "CASCADE: Backend (FastAPI — debug)" launch config for debugging.
    // -------------------------------------------------------------------------
    {
      "label": "CASCADE: Start Backend",
      "type": "shell",
      "command": ".venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}/CASCADE-backend",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/CASCADE-backend"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "INFO.*Uvicorn running|Started reloader",
          "endsPattern": "Application startup complete"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "cascade-servers"
      }
    },

    // -------------------------------------------------------------------------
    // Full stack — hot reload on both, no debugger (Ctrl+Shift+B default)
    // -------------------------------------------------------------------------
    {
      "label": "CASCADE: Start Full Stack",
      "dependsOn": [
        "CASCADE: Start Frontend",
        "CASCADE: Start Backend"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },

    // -------------------------------------------------------------------------
    // Full stack (debug mode) — frontend exposes Node inspector on 9229,
    // backend runs with --reload. Then attach debug configs from launch.json.
    // -------------------------------------------------------------------------
    {
      "label": "CASCADE: Start Full Stack (debug)",
      "dependsOn": [
        "CASCADE: Start Frontend (debug)",
        "CASCADE: Start Backend"
      ],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },

    // -------------------------------------------------------------------------
    // Type-check frontend (tsc --noEmit)
    // -------------------------------------------------------------------------
    {
      "label": "CASCADE: Type Check Frontend",
      "type": "shell",
      "command": "npx tsc --noEmit",
      "options": {
        "cwd": "${workspaceFolder}/CASCADE-app"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$tsc"
    },

    // -------------------------------------------------------------------------
    // Backend tests (pytest)
    // -------------------------------------------------------------------------
    {
      "label": "CASCADE: Run Backend Tests",
      "type": "shell",
      "command": ".venv/bin/python -m pytest test/ -v --tb=short",
      "options": {
        "cwd": "${workspaceFolder}/CASCADE-backend",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/CASCADE-backend"
        }
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },

    // -------------------------------------------------------------------------
    // Dev Postgres — throwaway container for local backend debugging.
    // Starts (or reuses) `cascade-dev-pg` on :5432 and blocks until it accepts
    // connections, so backend startup migrations don't race it. Used as the
    // preLaunchTask of "CASCADE: Backend — FastAPI + DB (debug)".
    // Stop/remove it with: docker rm -f cascade-dev-pg
    // -------------------------------------------------------------------------
    {
      "label": "CASCADE: Dev Postgres",
      "type": "shell",
      "command": "docker start cascade-dev-pg 2>/dev/null || docker run -d --name cascade-dev-pg -e POSTGRES_USER=cascade -e POSTGRES_PASSWORD=cascade -e POSTGRES_DB=cascade -p 5432:5432 postgres:16; for i in $(seq 1 30); do docker exec cascade-dev-pg pg_isready -U cascade >/dev/null 2>&1 && exit 0; sleep 1; done; echo 'postgres did not become ready'; exit 1",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },

    // -------------------------------------------------------------------------
    // Full containerized stack — db + backend + web (Caddy) + Zitadel.
    // This is the REAL full stack (auth-capable). Creates deploy/.env from the
    // example on first run. App at http://localhost:8080, Zitadel :8081.
    // -------------------------------------------------------------------------
    {
      "label": "CASCADE: Full Stack (Docker Compose)",
      "type": "shell",
      "command": "[ -f .env ] || cp .env.example .env; docker compose up -d --build",
      "options": {
        "cwd": "${workspaceFolder}/deploy"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },

    // -------------------------------------------------------------------------
    // Tear down the containerized stack (add ` -v` by hand to also wipe data).
    // -------------------------------------------------------------------------
    {
      "label": "CASCADE: Full Stack (Docker Compose) — Down",
      "type": "shell",
      "command": "docker compose down",
      "options": {
        "cwd": "${workspaceFolder}/deploy"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }

  ]
}
