{
  "version": "0.2.0",
  "configurations": [

    // =========================================================================
    // FRONTEND
    // =========================================================================

    // -------------------------------------------------------------------------
    // Client-side React (Chrome DevTools) — THE PLATFORM
    //
    // Attaches Chrome to the already-running dev server on port 3000 and opens
    // the Canvas Editor. Use this for breakpoints in browser-executed code
    // (components, hooks). Prerequisite: dev server running via the compound or
    // tasks.json.
    //
    // The URL carries /app deliberately: the public website owns "/" (see
    // requirements.md §17), so a bare origin would open the landing page —
    // which is a server-rendered page with nothing to breakpoint. This is the
    // default configuration, and the one the Full Stack compound uses.
    // -------------------------------------------------------------------------
    {
      "type": "chrome",
      "request": "launch",
      "name": "CASCADE: Frontend — Client (Chrome)",
      "url": "http://localhost:3000/app",
      "webRoot": "${workspaceFolder}/CASCADE-app",
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${workspaceFolder}/CASCADE-app/*"
      },
      "userDataDir": "${workspaceFolder}/.vscode/.chrome-debug-profile",
      "preLaunchTask": "CASCADE: Start Frontend"
    },

    // -------------------------------------------------------------------------
    // Server-side Next.js (Node debugger — attaches to running server)
    //
    // The dev server must be started via the "CASCADE: Start Frontend (debug)"
    // task in tasks.json, which passes NODE_OPTIONS=--inspect=9229.
    // Once the server is up, run this config to attach and get breakpoints in
    // Server Components, route handlers, and middleware.
    // -------------------------------------------------------------------------
    {
      "type": "node",
      "request": "attach",
      "name": "CASCADE: Frontend — Server (attach Node)",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/CASCADE-app",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/CASCADE-app/**",
        "!**/node_modules/**"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/CASCADE-app/node_modules/**"
      ],
      "preLaunchTask": "CASCADE: Start Frontend (debug)"
    },

    // =========================================================================
    // WEBSITE — secondary
    //
    // The public landing page. These exist so the site can be opened on demand;
    // nothing above pulls them in, and the Full Stack compound does not use
    // them. Both bands are server components, so the useful debugging here is
    // layout and copy in the browser rather than breakpoints.
    // =========================================================================

    {
      "type": "chrome",
      "request": "launch",
      "name": "CASCADE: Website — Landing (Chrome)",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/CASCADE-app",
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${workspaceFolder}/CASCADE-app/*"
      },
      "userDataDir": "${workspaceFolder}/.vscode/.chrome-debug-profile",
      "preLaunchTask": "CASCADE: Start Frontend"
    },

    {
      "type": "chrome",
      "request": "launch",
      "name": "CASCADE: Website — Landing IT (Chrome)",
      "url": "http://localhost:3000/it",
      "webRoot": "${workspaceFolder}/CASCADE-app",
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${workspaceFolder}/CASCADE-app/*"
      },
      "userDataDir": "${workspaceFolder}/.vscode/.chrome-debug-profile",
      "preLaunchTask": "CASCADE: Start Frontend"
    },

    // =========================================================================
    // BACKEND
    // =========================================================================

    // -------------------------------------------------------------------------
    // FastAPI (debugpy, no --reload)
    //
    // uvicorn --reload forks a child; debugpy cannot follow that fork.
    // This config runs without --reload so breakpoints work reliably.
    // For live-reload without debugging, use "CASCADE: Start Backend" task.
    //
    // Venv setup (first time only):
    //   cd CASCADE-backend
    //   python3 -m venv .venv
    //   .venv/bin/pip install -r requirements.txt -r requirements-dev.txt
    // -------------------------------------------------------------------------
    {
      "type": "debugpy",
      "request": "launch",
      "name": "CASCADE: Backend — FastAPI (debug)",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host", "0.0.0.0",
        "--port", "8000"
      ],
      "cwd": "${workspaceFolder}/CASCADE-backend",
      "python": "${workspaceFolder}/CASCADE-backend/.venv/bin/python",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/CASCADE-backend"
      },
      "jinja": true,
      "justMyCode": true,
      "envFile": "${workspaceFolder}/CASCADE-backend/.env"
    },

    // -------------------------------------------------------------------------
    // pytest — full test suite (breakpoints work inside tests and source)
    // -------------------------------------------------------------------------
    {
      "type": "debugpy",
      "request": "launch",
      "name": "CASCADE: Backend — Tests (pytest)",
      "module": "pytest",
      "args": ["test/", "-v", "--tb=short"],
      "cwd": "${workspaceFolder}/CASCADE-backend",
      "python": "${workspaceFolder}/CASCADE-backend/.venv/bin/python",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/CASCADE-backend"
      },
      "justMyCode": false,
      "envFile": "${workspaceFolder}/CASCADE-backend/.env"
    },

    // -------------------------------------------------------------------------
    // Current Python file — quick ad-hoc script debugging
    // -------------------------------------------------------------------------
    {
      "type": "debugpy",
      "request": "launch",
      "name": "CASCADE: Backend — Current file",
      "program": "${file}",
      "cwd": "${workspaceFolder}/CASCADE-backend",
      "python": "${workspaceFolder}/CASCADE-backend/.venv/bin/python",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/CASCADE-backend"
      },
      "justMyCode": true,
      "envFile": "${workspaceFolder}/CASCADE-backend/.env"
    },

    // -------------------------------------------------------------------------
    // FastAPI + database (debugpy)
    //
    // Same as the FastAPI debug config, but first starts a throwaway dev
    // Postgres (preLaunchTask) and points DATABASE_URL at it, so startup
    // migrations run and the DB-backed features (users, roles, entitlements,
    // account deletion, audit log) actually work while you debug.
    //
    // Auth is still OFF (no OIDC) => every request is a synthetic admin with
    // unbounded entitlement. To exercise the auth/entitlement gates by hand use
    // the Docker Compose stack (with Zitadel); otherwise use the pytest suite.
    // -------------------------------------------------------------------------
    {
      "type": "debugpy",
      "request": "launch",
      "name": "CASCADE: Backend — FastAPI + DB (debug)",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host", "0.0.0.0",
        "--port", "8000"
      ],
      "cwd": "${workspaceFolder}/CASCADE-backend",
      "python": "${workspaceFolder}/CASCADE-backend/.venv/bin/python",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/CASCADE-backend",
        "DATABASE_URL": "postgresql://cascade:cascade@localhost:5432/cascade"
      },
      "justMyCode": true,
      "envFile": "${workspaceFolder}/CASCADE-backend/.env",
      "preLaunchTask": "CASCADE: Dev Postgres"
    }

  ],

  // ===========================================================================
  // Compounds
  // ===========================================================================
  "compounds": [

    // -------------------------------------------------------------------------
    // Full Stack — DB + backend debugger + Chrome client debugger
    //
    // Starts a dev Postgres (preLaunchTask on the backend), the frontend dev
    // server (preLaunchTask on the Chrome config), and the backend under
    // debugpy. Chrome opens the editor at :3000/app -> API (:8000); CORS
    // already allows :3000.
    // For the FULL containerized stack incl. Zitadel, run the task
    // "CASCADE: Full Stack (Docker Compose)" instead.
    // -------------------------------------------------------------------------
    {
      "name": "CASCADE: Full Stack",
      "configurations": [
        "CASCADE: Frontend — Client (Chrome)",
        "CASCADE: Backend — FastAPI + DB (debug)"
      ],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "CASCADE",
        "order": 1
      }
    },

    // -------------------------------------------------------------------------
    // Full Stack (server-side JS + Python) — for API-layer debugging
    //
    // Starts the frontend dev server in debug mode automatically (preLaunchTask
    // on the Node attach config), then attaches both the Node inspector and debugpy.
    // -------------------------------------------------------------------------
    {
      "name": "CASCADE: Full Stack (server-side)",
      "configurations": [
        "CASCADE: Frontend — Server (attach Node)",
        "CASCADE: Backend — FastAPI (debug)"
      ],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "CASCADE",
        "order": 2
      }
    }

  ]
}
