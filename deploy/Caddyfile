# Caddy config for CASCADE.
#
# Site addresses are supplied by environment variables so the same file works
# locally (HTTP on a port) and in production (real hostnames with automatic TLS):
#   APP_DOMAIN         — the app: static frontend + /api reverse-proxied to the backend
#   ID_DOMAIN          — Zitadel (the identity provider)
#   LEGACY_APP_DOMAIN  — optional: redirects an old pre-website APP_DOMAIN to the apex
#   WWW_DOMAIN         — optional: redirects www.<apex> to the apex
#   ERRORS_DOMAIN      — optional: GlitchTip (self-hosted error/performance tracking)
#
# When these are real hostnames (e.g. app.example.org), Caddy automatically
# provisions and renews Let's Encrypt certificates. When they are a bare port
# (e.g. ":80", local testing) it just serves plain HTTP.
#
# Optional: add an ACME contact email in production for expiry notices:
#   { email you@example.org }

{
	# The rate_limit handler (github.com/mholt/caddy-ratelimit, built into the
	# image via deploy/web.Dockerfile) must be ordered explicitly.
	order rate_limit before basic_auth
}

# Reusable security headers for the app site. Zitadel is deliberately excluded —
# it sets its own headers/CSP and imposing ours would break its console.
(security_headers) {
	header {
		# HTTPS-only for a year (browsers ignore this over plain HTTP locally).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# Permissive-but-safe CSP. 'unsafe-inline' is needed for Next's inline
		# bootstrap + React inline styles; https:/blob: cover MapLibre tiles and
		# workers. Tighten to your exact tile hosts if you want a stricter policy.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https:; worker-src 'self' blob:; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'"
		# Don't advertise the server software.
		-Server
	}
}

{$APP_DOMAIN} {
	import security_headers
	encode zstd gzip

	# Rate-limit only the abuse-prone auth endpoints (login/callback/refresh) per
	# client IP — a defence for the login door (the engine-evaluation budget
	# protects /api/propagate separately). The read-only /config and /me are
	# deliberately NOT limited: they're called on every page load, so a customer
	# whose office shares one NAT egress IP would otherwise hit false 429s.
	@auth path /api/auth/login /api/auth/callback /api/auth/refresh
	rate_limit @auth {
		zone auth {
			key {remote_host}
			events 60
			window 1m
		}
	}

	# API and IdP share the app's origin, so the browser makes same-origin
	# requests and needs no CORS. /api/* goes to the backend unchanged.
	# request_body caps what FastAPI would otherwise buffer in memory — without
	# it one authenticated client POSTing a huge JSON body can OOM the small VM.
	# 10MB comfortably fits entitlement-capped networks (a 300-node project
	# serialises to well under 1MB).
	handle /api/* {
		request_body {
			max_size 10MB
		}
		reverse_proxy backend:8000
	}

	# Everything else is the static single-page frontend.
	handle {
		root * /srv

		# Next.js chunk filenames are content-hashed => safe to cache forever.
		@immutable path /_next/static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# Everything else (HTML above all — it is NOT content-hashed) defaults
		# to no-cache: browsers must revalidate (ETag/304) on each load. A
		# cached index.html kept referencing old JS after a redeploy and the
		# stale bundle called the API with outdated parameters — a real
		# incident. `?` sets the header only where not already set above.
		header ?Cache-Control "no-cache"

		# A page is a real file: `/it` is it.html, `/app` is app.html. Falling
		# back to /index.html would answer every unknown URL with the landing
		# page under HTTP 200 — a soft 404, which a search engine reads as a
		# duplicate of the home page rather than as a missing one.
		try_files {path} {path}.html
		file_server
	}

	# Anything that matched no file: Next's own 404 page, under a real 404.
	#
	# `handle_errors` is its own route tree, separate from the main chain above
	# — the top-level `import security_headers` on this site block does not
	# reach it. Without importing it again here, an error response ships with
	# none of CSP/HSTS/X-Frame-Options/etc., and `-Server` stops suppressing
	# the `Server: Caddy` header — caught in production by `curl -sI` on an
	# unknown path returning a 404 with only default headers.
	handle_errors {
		import security_headers
		root * /srv
		rewrite * /404.html
		file_server {
			status {err.status_code}
		}
	}
}

# The domain the whole app used to be served from, before the public website
# took over the apex and the editor moved from "/" to "/app" (see
# docs/project/architecture.md's routing section). Left resolving and
# permanently redirected rather than deleted outright, so old bookmarks and
# any already-indexed links keep working instead of failing outright — a
# visitor lands on the apex equivalent of whatever they had.
#
# The bare root used to BE the editor, so it is the one path that does not
# map 1:1 — everything else (the API, /admin, /auth/callback, static assets)
# kept its exact path under the apex, so those redirect unchanged.
{$LEGACY_APP_DOMAIN} {
	@root path /
	redir @root https://{$APP_DOMAIN}/app 301
	redir * https://{$APP_DOMAIN}{uri} 301
}

# The www spelling of the apex. People type it, and a search engine treats
# www and the apex as two sites, so it answers with a permanent redirect to the
# one canonical origin instead of serving a second copy of the website.
{$WWW_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} 308
}

{$ID_DOMAIN} {
	# Zitadel v3+ moved its login screen into a separate Next.js app (Login V2,
	# github.com/zitadel/zitadel-login) reachable under /ui/v2/login. That app
	# is prod-only (see docker-compose.prod.yml); route its path prefix there
	# before the catch-all below sends everything else to the API/console.
	@loginv2 path /ui/v2/login*
	handle @loginv2 {
		reverse_proxy zitadel-login:3000
	}

	# Zitadel serves gRPC (console + management API) alongside HTTP on 8080.
	# Proxy over HTTP/2 cleartext (h2c) so the gRPC traffic works. Zitadel sets
	# its own security headers.
	handle {
		reverse_proxy zitadel:8080 {
			transport http {
				versions h2c 2
			}
		}
	}
}

# GlitchTip — self-hosted error/performance tracking (docker-compose.yml,
# docs/project/deployment.md). A Django app, like Zitadel excluded from
# `security_headers` above: it sets its own.
{$ERRORS_DOMAIN} {
	reverse_proxy glitchtip:8000
}
