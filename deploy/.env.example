# CASCADE — Compose environment. Copy to `.env` (same directory) and fill in.
# `.env` holds secrets: it is gitignored and must be chmod 600 on the server.

# --- Environment ------------------------------------------------------------
# development | production. In production the backend REFUSES to start unless
# OIDC is configured (see config.assert_production_safe).
ENV=development

# --- Database ---------------------------------------------------------------
# Used by both Postgres (to create the cluster) and the backend (to connect).
POSTGRES_USER=cascade
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=cascade

# --- Web / Caddy ------------------------------------------------------------
# Real hostnames in production => automatic HTTPS. Leave unset locally to serve
# plain HTTP (app on :80 -> published at http://localhost:8080).
# This one vhost serves the public website (/ and /it), the editor (/app) and
# /api. The landing page is what search engines index, so the apex is normally
# the right choice here.
# APP_DOMAIN=example.org
# ID_DOMAIN=id.example.org
# The site's public origin — MUST be https://$APP_DOMAIN. Every absolute URL in
# page metadata is built from it: the canonical link, the hreflang alternates
# pairing / with /it, the og:image a chat app fetches, and sitemap.xml's own
# entries. Read at IMAGE BUILD time, so changing it needs `up -d --build web`,
# not just a restart. Unset => the app falls back to http://localhost:3000,
# which makes link previews fail and publishes a sitemap nobody can use.
# SITE_URL=https://example.org

# --- Zitadel (identity provider) --------------------------------------------
# Master encryption key — MUST be exactly 32 characters. Generate with:
#   openssl rand -base64 24 | cut -c1-32     (or `tr -dc A-Za-z0-9 </dev/urandom | head -c32`)
ZITADEL_MASTERKEY=change-me-to-a-32-char-secretkey
# Password for Zitadel's dedicated Postgres runtime role (zitadel_user), created
# on first boot by deploy/db-init/. Keeps the IdP off the superuser account.
ZITADEL_DB_PASSWORD=change-me-to-a-different-long-random-string
# REQUIRED in production (docker-compose.prod.yml pins the separate Login V2
# image, ghcr.io/zitadel/zitadel-login, to this same tag — it has no default).
# Check available tags at https://github.com/zitadel/zitadel/releases.
ZITADEL_VERSION=

# First-instance bootstrap: creates your Zitadel admin login on first boot
# (only takes effect against a FRESH `zitadel` database — see deployment.md).
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_EMAIL=change-me@example.org
ZITADEL_ADMIN_PASSWORD=change-me-to-a-long-random-string
# Expiry (RFC3339) for the login-client machine token Login V2 uses to call
# the API. Rotate by wiping the `zitadel` DB and re-bootstrapping before this
# date; the default is a decade out so v1 doesn't need to think about it.
ZITADEL_LOGIN_CLIENT_PAT_EXPIRATION=2030-01-01T00:00:00Z

# --- Backend ----------------------------------------------------------------
# Exact frontend origin(s) allowed by CORS. Behind Caddy the app is same-origin,
# so this is only needed if a browser calls the API cross-origin. Prod: https://app.<domain>
CORS_ORIGINS=http://localhost:3000

# --- OIDC (Zitadel) — leave blank until the identity provider is wired -------
# OIDC_REDIRECT_URI must be the FRONTEND callback page, e.g.
#   https://<domain>/auth/callback
# (unchanged by the public website: the callback kept its path when the editor
#  moved to /app, so an existing Zitadel application needs no edit)
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
JWT_AUDIENCE=
# Optional: Zitadel IdP id of a configured Google provider. Set it to show the
# "Continue with Google" button; leave blank and no request to Google is ever
# made. Enabling it makes Google a recipient of personal data — name it in your
# privacy notice first (docs/project/privacy-and-data-protection.md).
OIDC_GOOGLE_IDP_ID=

# --- Observability (optional) -----------------------------------------------
# Error tracking. Point at a Sentry or self-hosted GlitchTip DSN to enable.
# The backend also exposes Prometheus metrics at /metrics (internal only).
SENTRY_DSN=

# --- Account erasure (optional) ---------------------------------------------
# Enables full GDPR erasure by also deleting the user in Zitadel. Needs a
# service-account token/PAT with user-delete scope. Without these, account
# deletion removes only the app record; delete the Zitadel user by hand to
# finish erasure and prevent re-registration on next login.
ZITADEL_MGMT_URL=
ZITADEL_MGMT_TOKEN=

# --- Backups (optional, consumed by deploy/backup.sh) -----------------------
# Where nightly dumps land, and how long they are kept. Set BACKUP_RCLONE_REMOTE
# to copy them OFF the VM — the only copy that survives losing the machine.
# BACKUP_GPG_RECIPIENT encrypts each dump to that key.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
BACKUP_GPG_RECIPIENT=
BACKUP_RCLONE_REMOTE=
