@misc{tafjord_proofwriter_2021,
	title = {{ProofWriter}: {Generating} {Implications}, {Proofs}, and {Abductive} {Statements} over {Natural} {Language}},
	shorttitle = {{ProofWriter}},
	url = {http://arxiv.org/abs/2012.13048},
	doi = {10.48550/arXiv.2012.13048},
	abstract = {Transformers have been shown to emulate logical deduction over natural language theories (logical rules expressed in natural language), reliably assigning true/false labels to candidate implications. However, their ability to generate implications of a theory has not yet been demonstrated, and methods for reconstructing proofs of answers are imperfect. In this work we show that a generative model, called ProofWriter, can reliably generate both implications of a theory and the natural language proof(s) that support them. In particular, iterating a 1-step implication generator results in proofs that are highly reliable, and represent actual model decisions (rather than post-hoc rationalizations). On the RuleTaker dataset, the accuracy of ProofWriter's proofs exceed previous methods by +9\% absolute, and in a way that generalizes to proof depths unseen in training and on out-of-domain problems. We also show that generative techniques can perform a type of abduction with high precision: Given a theory and an unprovable conclusion, identify a missing fact that allows the conclusion to be proved, along with a proof. These results significantly improve the viability of neural methods for systematically reasoning over natural language.},
	language = {en},
	urldate = {2025-11-27},
	publisher = {arXiv},
	author = {Tafjord, Oyvind and Mishra, Bhavana Dalvi and Clark, Peter},
	month = jun,
	year = {2021},
	note = {arXiv:2012.13048 [cs]},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Computation and Language},
	file = {PDF:/home/cristian-curaba/snap/zotero-snap/common/Zotero/storage/U5PBKNVP/Tafjord et al. - 2021 - ProofWriter Generating Implications, Proofs, and Abductive Statements over Natural Language.pdf:application/pdf},
}

@misc{morishita_enhancing_2024,
	title = {Enhancing {Reasoning} {Capabilities} of {LLMs} via {Principled} {Synthetic} {Logic} {Corpus}},
	url = {http://arxiv.org/abs/2411.12498},
	doi = {10.48550/arXiv.2411.12498},
	abstract = {Large language models (LLMs) are capable of solving a wide range of tasks, yet they have struggled with reasoning. To address this, we propose \${\textbackslash}textbf\{Additional Logic Training (ALT)\}\$, which aims to enhance LLMs' reasoning capabilities by program-generated logical reasoning samples. We first establish principles for designing high-quality samples by integrating symbolic logic theory and previous empirical insights. Then, based on these principles, we construct a synthetic corpus named \${\textbackslash}textbf\{Formal Logic Deduction Diverse\}\$ (\${\textbackslash}textbf\{FLD\}\$\$\_\{{\textbackslash}times 2\}\$), comprising numerous samples of multi-step deduction with unknown facts, diverse reasoning rules, diverse linguistic expressions, and challenging distractors. Finally, we empirically show that ALT on FLD\$\_\{{\textbackslash}times2\}\$ substantially enhances the reasoning capabilities of state-of-the-art LLMs, including LLaMA-3.1-70B. Improvements include gains of up to 30 points on logical reasoning benchmarks, up to 10 points on math and coding benchmarks, and 5 points on the benchmark suite BBH.},
	urldate = {2025-11-29},
	publisher = {arXiv},
	author = {Morishita, Terufumi and Morio, Gaku and Yamaguchi, Atsuki and Sogawa, Yasuhiro},
	month = dec,
	year = {2024},
	note = {arXiv:2411.12498 [cs]},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Logic in Computer Science, Computer Science - Machine Learning},
	file = {Preprint PDF:/home/cristian-curaba/snap/zotero-snap/common/Zotero/storage/GRNM4CHM/Morishita et al. - 2024 - Enhancing Reasoning Capabilities of LLMs via Principled Synthetic Logic Corpus.pdf:application/pdf;Preprint PDF:/home/cristian-curaba/snap/zotero-snap/common/Zotero/storage/A5IYIZXS/Morishita et al. - 2024 - Enhancing Reasoning Capabilities of LLMs via Principled Synthetic Logic Corpus.pdf:application/pdf;Snapshot:/home/cristian-curaba/snap/zotero-snap/common/Zotero/storage/IF34LZ3A/2411.html:text/html},
