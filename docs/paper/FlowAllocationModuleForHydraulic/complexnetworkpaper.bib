	file = {APS Snapshot:/home/cristian-curaba/snap/zotero-snap/common/Zotero/storage/28A322JE/PhysRevE.69.html:text/html;Full Text PDF:/home/cristian-curaba/snap/zotero-snap/common/Zotero/storage/DHC2CCIU/Crucitti et al. - 2004 - Model for cascading failures in complex networks.pdf:application/pdf},
