@article{wan_survey_2021,
	title = {A {Survey} on {Centrality} {Metrics} and {Their} {Implications} in {Network} {Resilience}},
	volume = {9},
	issn = {2169-3536},
	url = {http://arxiv.org/abs/2011.14575},
	doi = {10.1109/ACCESS.2021.3094196},
	abstract = {Centrality metrics have been used in various networks, such as communication, social, biological, geographic, or contact networks. In particular, they have been used in order to study and analyze targeted attack behaviors and investigated their effect on network resilience. Although a rich volume of centrality metrics has been developed for decades, a limited set of centrality metrics have been commonly in use. This paper aims to introduce various existing centrality metrics and discuss their applicabilities and performance based on the results obtained from extensive simulation experiments to encourage their use in solving various computing and engineering problems in networks.},
	urldate = {2026-02-27},
	journal = {IEEE Access},
	author = {Wan, Zelin and Mahajan, Yash and Kang, Beom Woo and Moore, Terrence J. and Cho, Jin-Hee},
	year = {2021},
	note = {arXiv:2011.14575 [cs]},
	keywords = {Computer Science - Social and Information Networks},
	pages = {104773--104819},
	file = {Preprint PDF:/home/cristian-curaba/snap/zotero-snap/common/Zotero/storage/K5RG4J7P/Wan et al. - 2021 - A Survey on Centrality Metrics and Their Implications in Network Resilience.pdf:application/pdf;Snapshot:/home/cristian-curaba/snap/zotero-snap/common/Zotero/storage/C4GJ4UI9/2011.html:text/html},
}

