@article{hoff_preparing_2023,
	title = {Preparing infrastructure for surprise: fusing synthetic network, interdependency, and cascading failure models},
	volume = {3},
	issn = {2634-4505},
	shorttitle = {Preparing infrastructure for surprise},
	url = {https://doi.org/10.1088/2634-4505/acd07d},
	doi = {10.1088/2634-4505/acd07d},
	abstract = {Faced with destabilizing conditions in the Anthropocene, infrastructure resilience modeling remains challenged to confront increasingly complex conditions toward quickly and meaningfully advancing adaptation. Data gaps, increasingly interconnected systems, and accurate behavior estimation (across scales and as both gradual and cascading failure) remain challenges for infrastructure modelers. Yet novel approaches are emerging—largely independently—that, if brought together, offer significant opportunities for rapidly advancing how we understand vulnerabilities and surgically invest in resilience. Of particular promise are interdependency modeling, cascading failure modeling, and synthetic network generation. We describe a framework for integrating these three domains toward an integrated modeling framework to estimate infrastructure networks where no data exist, connect infrastructure to establish interdependencies, assess the vulnerabilities of these interconnected infrastructure to hazards, and simulate how failures may propagate across systems. We draw from the literature as an evidence base, provide a conceptual structure for implementation, and conclude by discussing the significance of such a framework and the critical tools it may provide to infrastructure researchers and managers.},
	language = {en},
	number = {2},
	urldate = {2025-11-11},
	journal = {Environ. Res.: Infrastruct. Sustain.},
	publisher = {IOP Publishing},
	author = {Hoff, Ryan M and Chester, Mikhail V},
	month = may,
	year = {2023},
	keywords = {NoN, synthetic network},
	pages = {025009},
	file = {IOP Full Text PDF:/home/cristian-curaba/snap/zotero-snap/common/Zotero/storage/2J63BZCA/Hoff and Chester - 2023 - Preparing infrastructure for surprise fusing synthetic network, interdependency, and cascading fail.pdf:application/pdf},
}

@article{yu_logical_2025,
	title = {Logical interdependencies in infrastructure: {What} are they, how to identify them, and what do they mean for infrastructure risk analysis?},
	volume = {45},
	copyright = {© 2024 The Author(s). Risk Analysis published by Wiley Periodicals LLC on behalf of Society for Risk Analysis.},
	issn = {1539-6924},
	shorttitle = {Logical interdependencies in infrastructure},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/risa.16555},
	doi = {10.1111/risa.16555},
	abstract = {A useful theoretical lens that has emerged for understanding urban resilience is the four basic types of interdependencies in critical infrastructures: the physical, geographic, cyber, and logical types. This paper is motivated by a conceptual and methodological limitation—although logical interdependencies (where two infrastructures affect the state of each other via human decisions) are regarded as one of the basic types of interdependencies, the question of how to apply the notion and how to quantify logical relations remains under-explored. To overcome this limitation, this study focuses on institutions (rules), for example, rules and planned tasks guiding human interactions with one another and infrastructure. Such rule-mediated interactions, when linguistically expressed, have a syntactic form that can be translated into a network form. We provide a foundation to delineate these two forms to detect logical interdependence. Specifically, we propose an approach to quantify logical interdependence based on the idea that (1) there are certain network motifs indicating logical relations, (2) such network motifs can be discerned from the network form of rules, and that (3) the higher the frequency of these motifs between two infrastructures, the greater the extent of logical interdependency. We develop a set of such motifs and illustrate their usage using an example. We conclude by suggesting a revision to the original definition of logical interdependence. This rule-focused approach is relevant to understanding human error in risk analysis of socio-technical systems, as human error can be seen as deviations from constraints that lead to accidents.},
	language = {en},
	number = {2},
	urldate = {2025-11-11},
	journal = {Risk Analysis},
	author = {Yu, David J. and Shin, Hoon C. and Olivier, Tomás and Garcia, Margaret and Meerow, Sara and Park, Jeryang},
	year = {2025},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/risa.16555},
	keywords = {infrastructure resilience, institutional grammar, institutions, Logical interdependencies in infrastructure, networks of plans},
	pages = {356--375},
	file = {Full Text PDF:/home/cristian-curaba/snap/zotero-snap/common/Zotero/storage/YT84WDJ9/Yu et al. - 2025 - Logical interdependencies in infrastructure What are they, how to identify them, and what do they m.pdf:application/pdf;Snapshot:/home/cristian-curaba/snap/zotero-snap/common/Zotero/storage/8CAGWJNQ/risa.html:text/html;Snapshot:/home/cristian-curaba/snap/zotero-snap/common/Zotero/storage/FMTIQ525/risa.html:text/html},
}

@article{aleta_multilayer_2026,
	title = {Multilayer network science: theory, methods, and applications},
	volume = {14},
	issn = {2051-1329},
	shorttitle = {Multilayer network science},
	url = {https://doi.org/10.1093/comnet/cnag007},
	doi = {10.1093/comnet/cnag007},
	abstract = {Multilayer network science has emerged as a central framework for analysing interconnected and interdependent complex systems. Its relevance has grown substantially with the increasing availability of rich, heterogeneous data, which makes it possible to uncover and exploit the inherently multilayered organisation of many real-world networks. In this review, we summarise recent developments in the field. On the theoretical and methodological front, we outline core concepts and survey advances in community detection, dynamical processes, temporal networks, higher-order interactions, and machine-learning-based approaches. On the application side, we discuss progress across diverse domains, including interdependent infrastructures, spreading dynamics, computational social science, economic and financial systems, ecological and climate networks, science-of-science studies, network medicine, and network neuroscience. We conclude with a forward-looking perspective, emphasizing the need for standardised datasets and software, deeper integration of temporal and higher-order structures, and a transition toward genuinely predictive models of complex systems.},
	number = {2},
	urldate = {2026-06-25},
	journal = {J Complex Netw},
	author = {Aleta, Alberto and Teixeira, Andreia Sofia and Ferraz de Arruda, Guilherme and Baronchelli, Andrea and Barrat, Alain and Kertész, János and Díaz-Guilera, Albert and Artime, Oriol and Starnini, Michele and Petri, Giovanni and Karsai, Márton and Patwardhan, Siddharth and Coronges, Kathryn and McCranie, Ann and Vespignani, Alessandro and Moreno, Yamir and Fortunato, Santo},
	month = apr,
	year = {2026},
	pages = {cnag007},
	file = {Snapshot:/home/cristian-curaba/snap/zotero-snap/common/Zotero/storage/TULXU7BB/cnag007.html:text/html;Submitted Version:/home/cristian-curaba/snap/zotero-snap/common/Zotero/storage/EGSXFB4T/Aleta et al. - 2026 - Multilayer network science theory, methods, and applications.pdf:application/pdf},
}

