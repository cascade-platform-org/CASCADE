@article{huang_failure_2020,
	title = {Failure mode and effect analysis improvement: {A} systematic literature review and future research agenda},
	volume = {199},
	issn = {0951-8320},
	shorttitle = {Failure mode and effect analysis improvement},
	url = {https://www.sciencedirect.com/science/article/pii/S095183201930105X},
	doi = {10.1016/j.ress.2020.106885},
	abstract = {Failure mode and effects analysis (FMEA) is a reliability management technique commonly utilized in various industries to guarantee the security and reliability of systems, services and projects. Nonetheless, the classical risk priority number (RPN) method has been criticized for many inherent deficiencies in the literature. Over the last decades, plenty of models and approaches have been employed to enhance the inherent characteristics of FMEA, but few contributions are devoted to review and summarize the related researches on FMEA improvement. Therefore, this paper aims to conduct a systematic review of the journal articles on the topic during the years between 1998 and 2018. A metadata statistical analysis is undertaken to present an overview of publication distribution across time and journals. Besides, a bibliometric analysis is performed to identify the most influential authors, institutions and areas, reveal the research hotspots and give an insight into the theme evolution in this field. The results indicated that the annual publications on FMEA improvement are rising quickly in the past two decades, especially after 2013; Liu HC, Chang KH, Kumar D, Sharma RK and You JX are the most prolific researchers; and Asian especially China is the major contributor in this field. Moreover, “healthcare failure mode”, “risk ranking”, “extended FMEA”, “gray theory”, “risk evaluation”, and “fuzzy inference” are the research focuses in improving the traditional FMEA.},
	urldate = {2026-03-30},
	journal = {Reliability Engineering \& System Safety},
	author = {Huang, Jia and You, Jian-Xin and Liu, Hu-Chen and Song, Ming-Shun},
	month = jul,
	year = {2020},
	keywords = {Failure mode and effects analysis (FMEA), Literature review, Reliability management, Risk evaluation, Risk priority number (RPN)},
	pages = {106885},
	file = {ScienceDirect Full Text PDF:/home/cristian-curaba/snap/zotero-snap/common/Zotero/storage/JQ4F2TUL/Huang et al. - 2020 - Failure mode and effect analysis improvement A systematic literature review and future research age.pdf:application/pdf;ScienceDirect Snapshot:/home/cristian-curaba/snap/zotero-snap/common/Zotero/storage/5S9ZQCEV/S095183201930105X.html:text/html},
