@article{aleta_multilayer_2026,
	title = {Multilayer network science: theory, methods, and applications},
	volume = {14},
	issn = {2051-1329},
	shorttitle = {Multilayer network science},
	url = {https://doi.org/10.1093/comnet/cnag007},
	doi = {10.1093/comnet/cnag007},
	abstract = {Multilayer network science has emerged as a central framework for analysing interconnected and interdependent complex systems. Its relevance has grown substantially with the increasing availability of rich, heterogeneous data, which makes it possible to uncover and exploit the inherently multilayered organisation of many real-world networks. In this review, we summarise recent developments in the field. On the theoretical and methodological front, we outline core concepts and survey advances in community detection, dynamical processes, temporal networks, higher-order interactions, and machine-learning-based approaches. On the application side, we discuss progress across diverse domains, including interdependent infrastructures, spreading dynamics, computational social science, economic and financial systems, ecological and climate networks, science-of-science studies, network medicine, and network neuroscience. We conclude with a forward-looking perspective, emphasizing the need for standardised datasets and software, deeper integration of temporal and higher-order structures, and a transition toward genuinely predictive models of complex systems.},
	number = {2},
	urldate = {2026-06-25},
	journal = {J Complex Netw},
	author = {Aleta, Alberto and Teixeira, Andreia Sofia and Ferraz de Arruda, Guilherme and Baronchelli, Andrea and Barrat, Alain and Kertész, János and Díaz-Guilera, Albert and Artime, Oriol and Starnini, Michele and Petri, Giovanni and Karsai, Márton and Patwardhan, Siddharth and Coronges, Kathryn and McCranie, Ann and Vespignani, Alessandro and Moreno, Yamir and Fortunato, Santo},
	month = apr,
	year = {2026},
	pages = {cnag007},
	file = {Snapshot:/home/cristian-curaba/snap/zotero-snap/common/Zotero/storage/TULXU7BB/cnag007.html:text/html},
}


@article{brunner_understanding_2024,
	title = {Understanding cascading risks through real-world interdependent urban infrastructure},
	volume = {241},
	issn = {0951-8320},
	url = {https://www.sciencedirect.com/science/article/pii/S0951832023005677},
	doi = {10.1016/j.ress.2023.109653},
	abstract = {The prevalence of cascading failures is growing as infrastructure becomes more interdependent and climate change exacerbates more extreme hazards. After such events, the general focus is on the magnitude of direct damage or loss; it is less understood how events trigger failures throughout other infrastructure. In this work, we present a methodology to model direct and indirect impacts from an event for a multi-system network, including interconnected infrastructure and end users. We perform a case study of New Zealand’s second largest city, Christchurch, investigating electricity, water supply, and wastewater networks following a range of coastal flooding events and climate change scenarios. For a 10-year average recurrence interval event given no sea-level rise, there is a 216\% increase from directly impacted end users to the total number of end users that have lost at least one utility. For the same scenario, this metric is 71\%, 129\%, and 131\% for end users who have lost electricity, water, and wastewater, respectively. The results show a larger estimate of impact on residents and a more geospatially-varied loss of service. This methodology provides insight for utility operators, emergency response, and communities on node criticality, areas of impact, and resource requirements after an event occurs.},
	urldate = {2026-04-30},
	journal = {Reliability Engineering \& System Safety},
	author = {Brunner, L. G. and Peer, R. A. M. and Zorn, C. and Paulik, R. and Logan, T. M.},
	month = jan,
	year = {2024},
	keywords = {Cascading failures, Critical infrastructure, Interdependent infrastructure, Network modeling, Resilience, Risk analysis, Urban infrastructure},
	pages = {109653},
	file = {ScienceDirect Full Text PDF:/home/cristian-curaba/snap/zotero-snap/common/Zotero/storage/U6LUHXU4/Brunner et al. - 2024 - Understanding cascading risks through real-world interdependent urban infrastructure.pdf:application/pdf;ScienceDirect Snapshot:/home/cristian-curaba/snap/zotero-snap/common/Zotero/storage/5WCFNBAE/S0951832023005677.html:text/html},
}