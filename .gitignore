# IDE debug junk. NOTE .vscode/ itself is tracked on purpose: launch.json and
# tasks.json are this repo's debug/run configs, and settings.json carries the
# tuned ChkTeX rule set for docs/paper/ with its rationale.
.vscode/.chrome-debug-profile/

# Per-machine Claude Code settings (tool permissions etc.). Kept out of the repo
# for everyone, not just whoever has it in their global git ignore.
**/.claude/settings.local.json

# Local backup artifacts from the monorepo migration
CASCADE-app.bak/
CASCADE-backend.bak/

# Deployment / runtime secrets — never commit. Only *.example templates are tracked.
**/.env
!**/.env.example

# Database backups produced by deploy/backup.sh
deploy/backups/

# Personal ops runbook (VM IP, SSH notes) — not for the repo
deploy/READ.me

# Real Italian aqueducts (proprietary utility data) + their GIS shapefiles —
# kept local only. The public benchmark networks (Net1/2/3, Modena, CTown) are
# tracked so the validation is reproducible.
raw-networks/aqueducts/Tarcento_totale.inp
raw-networks/aqueducts/Zampis.inp
raw-networks/aqueducts/Cassacco_totale.inp
raw-networks/aqueducts/_shapefiles_/

# WNTR/EPANET skeletonize(use_epanet=True) always writes these relative to cwd
# (no file_prefix knob for that codepath) — see skeleton.py's _SKELETONIZE_LOCK note.
CASCADE-backend/temp.inp
CASCADE-backend/temp.rpt
CASCADE-backend/temp.bin

# Auto-saved recovery snapshots written by CASCADE-app/lib/file-io.ts into
# whichever directory the user picked (File System Access API). Matched by name
# rather than by location: one was committed into samples/ before, when the
# chosen directory happened to be a tracked one.
cascade-recovery-*.json

# Ignore everything under docs/paper/, then re-track the three publishable
# manuscript sources (folder + its .tex/.bib/figures). Each folder's own
# .gitignore drops LaTeX build artifacts and any non-open-source class files
# (the Springer SVProc template — CLAUDE.md §1); elsarticle.cls is LPPL and
# stays tracked.
docs/paper/*
!docs/paper/FlowAllocationModuleForHydraulic/
!docs/paper/VitalityForInterdependentNetworks/
!docs/paper/IJDRR-CASCADE/

# ── Experiments (repo-root, not deployed) ────────────────────────────────────
# Harness scripts and ATTEMPTS.md ARE tracked. Ignored: investigation kits
# (REAL aqueduct data — never commit), archived outputs, logs, caches.
experiments/aqueducts/worst-situations/
experiments/aqueducts/archive/
experiments/aqueducts/*log*.txt
experiments/aqueducts/*.log
experiments/aqueducts/*.csv
# ...EXCEPT the anonymized, publishable copies (network column -> Aqueduct A/B/C,
# regenerated by experiments/aqueducts/anonymize_results.py). These ARE tracked:
# the Data and Code Availability statement promises them.
!experiments/aqueducts/results/
!experiments/aqueducts/results/*.csv
# Any depth, not just experiments/__pycache__/ — a nested one (centrality/) had
# slipped through and got a .pyc committed.
__pycache__/
*.pyc


# ── Root-level tool caches ───────────────────────────────────────────────────
# Each tool writes a self-ignoring .gitignore inside these, so nothing has
# leaked; naming them here does not depend on that behaviour continuing.
.pytest_cache/
.ruff_cache/
.import_linter_cache/
node_modules/
coverage/

# ── OS / editor junk ─────────────────────────────────────────────────────────
# The two sub-projects carry these already; the repo root did not.
.DS_Store
Thumbs.db
*.swp

# Personal setup
skills-lock.json

## ── Business docs (not for public repo) ───────────────────────────────────────
docs/business/*


# local agent set-up
.claude/*
.agents/*