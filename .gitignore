# IDE debug junk
.vscode/.chrome-debug-profile/

# Local backup artifacts from the monorepo migration
CASCADE-app.bak/
CASCADE-backend.bak/

# Deployment / runtime secrets — never commit. Only *.example templates are tracked.
**/.env
!**/.env.example

# Database backups produced by deploy/backup.sh
deploy/backups/

# Personal ops runbook (VM IP, SSH notes) — not for the repo
deploy/READ.me

# Real Italian aqueducts (proprietary utility data) + their GIS shapefiles —
# kept local only. The public benchmark networks (Net1/2/3, Modena, CTown) are
# tracked so the validation is reproducible.
raw-networks/aqueducts/Tarcento_totale.inp
raw-networks/aqueducts/Zampis.inp
raw-networks/aqueducts/Cassacco_totale.inp
raw-networks/aqueducts/_shapefiles_/

# WNTR/EPANET skeletonize(use_epanet=True) always writes these relative to cwd
# (no file_prefix knob for that codepath) — see skeleton.py's _SKELETONIZE_LOCK note.
CASCADE-backend/temp.inp
CASCADE-backend/temp.rpt
CASCADE-backend/temp.bin

docs/paper/*
docs/paper/IJDRR-CASCADE/*

# ── Experiments (repo-root, not deployed) ────────────────────────────────────
# Harness scripts and ATTEMPTS.md ARE tracked. Ignored: investigation kits
# (REAL aqueduct data — never commit), archived outputs, logs, caches.
experiments/aqueducts/worst-situations/
experiments/aqueducts/archive/
experiments/aqueducts/*log*.txt
experiments/aqueducts/*.log
experiments/aqueducts/*.csv
# ...EXCEPT the anonymized, publishable copies (network column -> Aqueduct A/B/C,
# regenerated by experiments/aqueducts/anonymize_results.py). These ARE tracked:
# the Data and Code Availability statement promises them.
!experiments/aqueducts/results/
!experiments/aqueducts/results/*.csv
experiments/__pycache__/
