# CASCADE Propagation Platform — Backend Environment Variables
# Copy this file to .env and fill in the values before starting the server.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

HOST=0.0.0.0
PORT=8000
# development | production. With ENV=production the server REFUSES to start
# unless OIDC is configured (local-only mode grants admin to every request).
ENV=development

# Comma-separated origins allowed by CORS.
# In production, set this to your exact frontend origin (no trailing slash).
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------

# Users & RBAC only — no project data is stored server-side (local-first).
DATABASE_URL=postgresql://cascade:changeme@localhost:5432/cascade_dev

# ---------------------------------------------------------------------------
# Authentication (OAuth2 / OIDC)
# Provider-agnostic — works with Keycloak, Authentik, Zitadel, etc.
# Leave OIDC_DISCOVERY_URL and OIDC_CLIENT_ID blank to run in single-user
# local mode (no auth required; development only).
# ---------------------------------------------------------------------------

# The /.well-known/openid-configuration URL of your identity provider.
OIDC_DISCOVERY_URL=http://localhost:8080/realms/cascade/.well-known/openid-configuration

OIDC_CLIENT_ID=cascade-backend
OIDC_CLIENT_SECRET=changeme

# Must be registered as an allowed redirect URI in your OIDC provider.
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Space-separated scopes to request. "openid email profile" is the minimum.
OIDC_SCOPES=openid email profile

# ---------------------------------------------------------------------------
# JWT validation
# ---------------------------------------------------------------------------

JWT_ALGORITHM=RS256                  # RS256 (asymmetric, recommended) or HS256
JWT_AUDIENCE=cascade-api             # must match the "aud" claim in the token

# NOTE: there is deliberately no rate-limiting setting yet — nothing enforces
# one. Add the flag together with its middleware (e.g. slowapi on
# /api/propagate) before any multi-user deployment.
